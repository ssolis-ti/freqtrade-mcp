# Embeddings para el RAG por bloque.
# Backend primario: gateway LiteLLM/Bifrost (compatible OpenAI). Si no responde o da 401,
# el framework degrada automaticamente a embeddings locales deterministas (local-hash).
#
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.

EMBED_BASE_URL=http://localhost:4000
EMBED_MODEL=text-embedding-3-small
EMBED_API_KEY=REEMPLAZA-CON-TU-KEY

# --- Backend Google Gemini (free tier, embeddings $0) ---
# Crear key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=REEMPLAZA-CON-TU-GEMINI-KEY
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# --- Seguridad del despacho (fase 1) ---
# Auth del gateway HTTP. Obligatoria para escuchar fuera de loopback.
GATEWAY_API_KEY=
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765
# Segundos de cache de la comprobacion de dry_run contra el bot.
DRY_RUN_TTL=30
# Operar con capital REAL. Lo pone el operador humano en el entorno del
# proceso, nunca una tool ni un agente. Sin esto, el bot en live se bloquea.
PERMITIR_LIVE=
