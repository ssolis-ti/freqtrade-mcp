# Embeddings para el RAG por bloque.
# Backend primario: gateway LiteLLM/Bifrost (compatible OpenAI). Si no responde o da 401,
# el framework degrada automaticamente a embeddings locales deterministas (local-hash).
#
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.

EMBED_BASE_URL=http://localhost:4000
EMBED_MODEL=text-embedding-3-small
EMBED_API_KEY=REEMPLAZA-CON-TU-KEY

# Directorio de vector stores (opcional; default data/rag dentro del proyecto)
# RAG_DATA_DIR=data/rag

# Umbral minimo de similitud de coseno para que un chunk cuente como hit (opcional)
# RAG_MIN_SCORE=0.25
